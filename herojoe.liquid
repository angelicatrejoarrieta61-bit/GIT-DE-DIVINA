
{% comment %}
  Section: Hero Glass Master V5.2 (Precision Architecture)
  Version: 5.2 - Split Offsets (Mobile/Desktop) & Expanded Precision
{% endcomment %}

{% liquid
  assign media_count = 0
  assign media_1 = 'none'
  assign media_2 = 'none'

  if section.settings.image_1 != blank and section.settings.media_type_1 == 'image'
    assign media_1 = 'image'
    assign media_count = media_count | plus: 1
  endif
  if section.settings.video_1 != blank and section.settings.media_type_1 == 'video'
    assign media_1 = 'video'
    assign media_count = media_count | plus: 1
  endif
  if section.settings.image_2 != blank and section.settings.media_type_2 == 'image'
    assign media_2 = 'image'
    assign media_count = media_count | plus: 1
  endif
  if section.settings.video_2 != blank and section.settings.media_type_2 == 'video'
    assign media_2 = 'video'
    assign media_count = media_count | plus: 1
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

<style>
  .hero-pro-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #000;
    {% if section.settings.overlap_header %}
      margin-top: calc(var(--header-height, 80px) * -1);
    {% endif %}
    --hero-h: {{ section.settings.desktop_height }}px;
    --hero-h-m: {{ section.settings.mobile_height }}px;
    --g-bg: {{ section.settings.glass_color | color_modify: 'alpha', section.settings.glass_opacity }};
    --g-blur: {{ section.settings.glass_blur }}px;
    --g-radius: {{ section.settings.glass_radius }}px;
    --x-off: {{ section.settings.x_offset_desktop }}px;
    --y-off: {{ section.settings.y_offset_desktop }}px;
  }

  .hero-pro-container-{{ section.id }} {
    position: relative;
    height: var(--hero-h);
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: {{ section.settings.horizontal_alignment }};
    padding: 60px;
    z-index: 10;
    {% if section.settings.overlap_header %}
      padding-top: var(--header-height, 80px);
    {% endif %}
  }

  .hero-pro-content-{{ section.id }} {
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
    animation: heroEntrance 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    background: var(--g-bg);
    backdrop-filter: blur(var(--g-blur));
    -webkit-backdrop-filter: blur(var(--g-blur));
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--g-radius);
    padding: 30px; /* Reducido de 60px a 30px */
    max-width: 720px;
    box-shadow: 0 50px 120px -20px rgba(0, 0, 0, 0.9), 
                inset 0 0 100px 0 rgba(255,255,255,0.03);
    position: relative;
    overflow: hidden;
    transform: translate(var(--x-off), var(--y-off));
  }

  .hero-pro-content-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.5), transparent);
    z-index: 2;
  }

  .hero-pro-media-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat({{ media_count | default: 1 }}, 1fr);
    gap: 1px;
  }

  .hero-pro-media-{{ section.id }} img, 
  .hero-pro-media-{{ section.id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness({{ section.settings.brightness }});
    transition: transform 15s ease-out;
  }

  .hero-pro-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_gradient }};
    z-index: 2;
    pointer-events: none;
  }

  {% if section.settings.enable_glow %}
  .hero-pro-glow-{{ section.id }} {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 50%;
    height: 60%;
    background: radial-gradient(circle, {{ section.settings.glow_color | color_modify: 'alpha', 0.2 }} 0%, transparent 70%);
    filter: blur(120px);
    z-index: 3;
    pointer-events: none;
    animation: glowShift 12s infinite alternate ease-in-out;
  }
  @keyframes glowShift {
    0% { transform: translate(0, 0) scale(1); opacity: 0.5; }
    100% { transform: translate(-10%, 10%) scale(1.2); opacity: 0.8; }
  }
  {% endif %}

  /* Bloques Dinámicos */
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'label' %}
        .block-label-{{ block.id }} {
          color: {{ block.settings.color }};
          font-size: {{ block.settings.size }}px;
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.6em;
          display: flex;
          align-items: center;
          gap: 20px;
          margin-bottom: 20px; /* Reducido para compactar */
        }
        .block-label-{{ block.id }}::before {
          content: '';
          height: 1px;
          width: 40px;
          background: {{ block.settings.color }};
        }
      {% when 'heading' %}
        .block-heading-{{ block.id }} {
          color: {{ block.settings.color }};
          font-size: {{ block.settings.size }}px;
          line-height: {{ block.settings.line_height }};
          font-weight: 800;
          letter-spacing: -0.06em;
          margin: 0 0 20px; /* Reducido de 30px */
          text-transform: uppercase;
          font-style: italic;
        }
        .block-heading-{{ block.id }} span {
          background: {{ block.settings.accent_gradient }};
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          font-style: normal;
        }
      {% when 'text' %}
        .block-text-{{ block.id }} {
          color: {{ block.settings.color | color_modify: 'alpha', 0.6 }};
          font-size: {{ block.settings.size }}px;
          line-height: 1.7;
          max-width: 550px;
          margin-bottom: 25px; /* Reducido de 40px */
          font-weight: 500;
        }
    {% endcase %}
  {% endfor %}

  @keyframes heroEntrance {
    0% { opacity: 0; transform: translateY(100px) translate(var(--x-off), var(--y-off)) scale(0.92); filter: blur(20px); }
    100% { opacity: 1; transform: translateY(0) translate(var(--x-off), var(--y-off)) scale(1); filter: blur(0); }
  }

  @media (max-width: 767px) {
    .hero-pro-{{ section.id }} {
      --x-off: {{ section.settings.x_offset_mobile }}px;
      --y-off: {{ section.settings.y_offset_mobile }}px;
    }
    .hero-pro-container-{{ section.id }} {
      height: var(--hero-h-m);
      padding: 30px 20px;
      align-items: flex-end;
    }
    .hero-pro-content-{{ section.id }} {
      padding: 20px 15px; /* Reducido de 40px 30px */
      border-radius: 24px;
      margin-bottom: 0;
      transform: translate(var(--x-off), var(--y-off)) !important;
    }
    {% for block in section.blocks %}
      {% if block.type == 'heading' %}
        .block-heading-{{ block.id }} { font-size: calc({{ block.settings.size }}px * 0.65); }
      {% endif %}
    {% endfor %}
  }
</style>

<section class="hero-pro-{{ section.id }}" id="Hero-{{ section.id }}">
  <div class="hero-pro-media-{{ section.id }}">
    {% if media_1 == 'image' %}
      {%- assign img1 = section.settings.image_1 -%}
      <img src="{{ img1 | image_url: width: 2800 }}" 
           alt="{{ img1.alt | escape }}" 
           width="{{ img1.width | default: 1920 }}"
           height="{{ img1.height | default: 1080 }}"
           loading="eager" 
           fetchpriority="{{ fetch_priority }}">
    {% elsif media_1 == 'video' %}
      {{ section.settings.video_1 | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
    {% endif %}
    
    {% if media_2 == 'image' %}
      {%- assign img2 = section.settings.image_2 -%}
      <img src="{{ img2 | image_url: width: 2800 }}" 
           alt="{{ img2.alt | escape }}" 
           width="{{ img2.width | default: 1920 }}"
           height="{{ img2.height | default: 1080 }}"
           loading="lazy">
    {% elsif media_2 == 'video' %}
      {{ section.settings.video_2 | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
    {% endif %}
  </div>

  <div class="hero-pro-overlay-{{ section.id }}"></div>
  {% if section.settings.enable_glow %}
    <div class="hero-pro-glow-{{ section.id }}"></div>
  {% endif %}

  <div class="hero-pro-container-{{ section.id }}">
    {% if section.blocks.size > 0 %}
      <div class="hero-pro-content-{{ section.id }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'label' %}
              <div class="block-label-{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {% when 'heading' %}
              <h1 class="block-heading-{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.title | replace: '[', '<span>' | replace: ']', '</span>' | newline_to_br }}
              </h1>
            {% when 'text' %}
              <p class="block-text-{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.content }}
              </p>
            {% when 'button' %}
              <div class="hero-btn-group" style="display: flex; gap: 20px; flex-wrap: wrap;">
                <a href="{{ block.settings.link }}" class="hero-btn-main" style="padding: 15px 40px; border-radius: 60px; background: white; color: black; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.3em; text-decoration: none; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
                  {{ block.settings.label }}
                </a>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- Scroll Hint -->
  <div style="position: absolute; bottom: 40px; left: 60px; z-index: 20; display: flex; align-items: center; gap: 20px;">
    <div style="width: 1px; height: 60px; background: linear-gradient(to bottom, transparent, #3062DF, transparent);"></div>
    <span style="font-size: 9px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5em; color: rgba(255,255,255,0.2); transform: rotate(90deg); transform-origin: left; white-space: nowrap;">SCROLL EXPERIENCE</span>
  </div>
</section>

{% schema %}
{
  "name": "Hero Architecture Pro V5",
  "tag": "section",
  "class": "shopify-hero-pro-v5",
  "settings": [
    {
      "type": "header",
      "content": "Alineación y Header"
    },
    {
      "type": "checkbox",
      "id": "overlap_header",
      "label": "Alinear a 0 (Debajo del Header)",
      "default": true
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal",
      "options": [
        { "value": "flex-start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Derecha" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical",
      "options": [
        { "value": "flex-start", "label": "Superior" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Inferior" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Ajustes de Precisión (Escritorio)"
    },
    { "type": "range", "id": "x_offset_desktop", "min": -800, "max": 800, "step": 20, "unit": "px", "label": "Ajuste X Desktop", "default": 0 },
    { "type": "range", "id": "y_offset_desktop", "min": -800, "max": 800, "step": 20, "unit": "px", "label": "Ajuste Y Desktop", "default": 0 },
    {
      "type": "header",
      "content": "Ajustes de Precisión (Móvil)"
    },
    { "type": "range", "id": "x_offset_mobile", "min": -400, "max": 400, "step": 10, "unit": "px", "label": "Ajuste X Móvil", "default": 0 },
    { "type": "range", "id": "y_offset_mobile", "min": -400, "max": 400, "step": 10, "unit": "px", "label": "Ajuste Y Móvil", "default": 0 },
    {
      "type": "header",
      "content": "Media de Fondo"
    },
    { "type": "select", "id": "media_type_1", "label": "Tipo Media", "options": [{ "value": "image", "label": "Imagen" }, { "value": "video", "label": "Video" }], "default": "image" },
    { "type": "image_picker", "id": "image_1", "label": "Imagen Primaria" },
    { "type": "video", "id": "video_1", "label": "Video Primario" },
    { "type": "range", "id": "brightness", "min": 0.1, "max": 1.0, "step": 0.1, "label": "Brillo Fondo", "default": 0.8 },
    { "type": "color_background", "id": "overlay_gradient", "label": "Overlay", "default": "linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%)" },
    {
      "type": "header",
      "content": "Dimensiones"
    },
    { "type": "range", "id": "desktop_height", "min": 500, "max": 1200, "step": 10, "unit": "px", "label": "Alto Desktop", "default": 850 },
    { "type": "range", "id": "mobile_height", "min": 300, "max": 1000, "step": 10, "unit": "px", "label": "Alto Mobile", "default": 750 },
    {
      "type": "header",
      "content": "Estética Prism Glass"
    },
    { "type": "color", "id": "glass_color", "label": "Color Card", "default": "#000000" },
    { "type": "range", "id": "glass_opacity", "min": 0, "max": 0.8, "step": 0.1, "label": "Opacidad", "default": 0.2 },
    { "type": "range", "id": "glass_blur", "min": 0, "max": 60, "step": 1, "unit": "px", "label": "Desenfoque", "default": 30 },
    { "type": "range", "id": "glass_radius", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Radio Bordes", "default": 40 },
    { "type": "checkbox", "id": "enable_glow", "label": "Glow Ambiental", "default": true },
    { "type": "color", "id": "glow_color", "label": "Color Glow", "default": "#3062DF" }
  ],
  "blocks": [
    {
      "type": "label",
      "name": "Etiqueta",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Estreno Exclusivo 2025" },
        { "type": "color", "id": "color", "label": "Color", "default": "#3062DF" },
        { "type": "range", "id": "size", "min": 8, "max": 18, "step": 1, "label": "Tamaño", "default": 11 }
      ]
    },
    {
      "type": "heading",
      "name": "Título Prism",
      "settings": [
        { "type": "textarea", "id": "title", "label": "Título", "default": "Arquitectura \n [de la Piel]" },
        { "type": "color", "id": "color", "label": "Color Base", "default": "#FFFFFF" },
        { "type": "color_background", "id": "accent_gradient", "label": "Gradiente Acento", "default": "linear-gradient(to right, #ffffff 0%, #3062DF 100%)" },
        { "type": "range", "id": "size", "min": 40, "max": 140, "step": 5, "label": "Tamaño", "default": 90 },
        { "type": "range", "id": "line_height", "min": 0.7, "max": 1.5, "step": 0.1, "label": "Interlineado", "default": 0.9 }
      ]
    },
    {
      "type": "text",
      "name": "Descripción",
      "settings": [
        { "type": "textarea", "id": "content", "label": "Contenido", "default": "Descubre la nueva generación de tratamientos con tecnología Prism Glass. Una fusión entre ciencia molecular y estética sublime." },
        { "type": "color", "id": "color", "label": "Color", "default": "#FFFFFF" },
        { "type": "range", "id": "size", "min": 14, "max": 28, "step": 1, "label": "Tamaño", "default": 20 }
      ]
    },
    {
      "type": "button",
      "name": "Botón",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Explorar Colección" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Master Architecture V5",
      "blocks": [
        { "type": "label" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
