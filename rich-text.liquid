<section class="rich-text">
  {% if section.settings.text != blank %}
    <div class="rich-text-content">{{ section.settings.text }}</div>
  {% endif %}
  
  {% if section.settings.heading != blank %}
    <h1>{{ section.settings.heading }}</h1>
  {% endif %}
  
  {% if section.settings.list != blank %}
    <div class="rich-text-list">{{ section.settings.list }}</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Texto enriquecido",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto principal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Encabezado",
      "default": "Nuestros decretos:"
    },
    {
      "type": "richtext",
      "id": "list",
      "label": "Lista de decretos"
    }
  ],
  "presets": [
    {
      "name": "Texto enriquecido"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.rich-text {
  max-width: 1000px;
  margin: 60px auto;
  padding: 40px 20px;
  text-align: center;
}
.rich-text h1 {
  font-size: 2.5em;
  margin: 30px 0 20px;
}
.rich-text-content,
.rich-text-list {
  line-height: 1.8;
  margin-bottom: 20px;
}
{% endstylesheet %}
