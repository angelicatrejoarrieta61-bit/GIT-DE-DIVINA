
{% comment %}
  Section: Divine Header & Hero Master V6.2 - Persistence & Interaction Pro
  - PERSISTENCIA: Almacenamiento en sessionStorage para recordar la última diapositiva vista tras recargas o clics.
  - PAUSA INTELIGENTE: El slider se detiene al pasar el ratón (hover) sobre los hotspots o el contenido.
  - ESTÉTICA GLASMÓRFICA PRO: Refinado de popovers con bordes de luz y efectos metálicos.
  - PERFORMANCE: Control estricto de width/height y carga diferida (lazy loading) inteligente.
{% endcomment %}

{% liquid
  assign header_bg_scroll = section.settings.header_bg_scroll | color_modify: 'alpha', section.settings.header_opacity_scroll
  assign main_font_family = section.settings.font_family
  assign title_font_family = section.settings.title_font_family | default: main_font_family
  assign desc_font_family = section.settings.desc_font_family | default: main_font_family
  assign nav_font_family = section.settings.nav_font_family | default: main_font_family
%}

<style>
  :root {
    --hh-font: {{ main_font_family.family }}, {{ main_font_family.fallback_families }};
    --hh-title-font: {{ title_font_family.family }}, {{ title_font_family.fallback_families }};
    --hh-desc-font: {{ desc_font_family.family }}, {{ desc_font_family.fallback_families }};
    --hh-nav-font: {{ nav_font_family.family }}, {{ nav_font_family.fallback_families }};
    --hh-accent: {{ section.settings.accent_color | default: '#3062DF' }};
  }

  /* Inyección de fuentes */
  {{ main_font_family | font_face: font_display: 'swap' }}
  {{ title_font_family | font_face: font_display: 'swap' }}
  {{ desc_font_family | font_face: font_display: 'swap' }}
  {% if section.settings.nav_font_family != blank %}
    {{ nav_font_family | font_face: font_display: 'swap' }}
  {% endif %}

  .hh-master-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 100vh;
    font-family: var(--hh-font);
    background: #000;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* --- HEADER --- */
  .hh-header-wrapper {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 3000;
    padding: 30px 50px;
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hh-header-wrapper.is-scrolled { padding: 15px 50px; }

  .hh-nav-capsule {
    max-width: 1400px; margin: 0 auto; height: 75px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 45px; border-radius: 100px;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid transparent; position: relative;
  }

  .hh-header-wrapper.is-scrolled .hh-nav-capsule {
    background: {{ header_bg_scroll }};
    backdrop-filter: blur({{ section.settings.header_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.header_blur }}px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  }

  .hh-nav-links { display: flex; gap: 35px; }
  .hh-nav-item {
    text-decoration: none !important;
    font-family: var(--hh-nav-font);
    font-size: {{ section.settings.nav_font_size }}px;
    font-weight: {{ section.settings.nav_font_weight }};
    letter-spacing: 0.25em; text-transform: uppercase;
    color: {{ section.settings.nav_color_idle }};
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }
  .hh-nav-item:hover { color: var(--hh-accent) !important; transform: translateY(-2px); }

  .hh-logo-wrap img {
    max-width: {{ section.settings.logo_max_width }}px !important;
    width: 100%; height: auto; display: block;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));
    image-rendering: -webkit-optimize-contrast;
  }

  /* --- HERO VIEWPORT --- */
  .hh-hero-viewport {
    position: relative;
    height: 100vh; width: 100%;
    border-radius: {{ section.settings.hero_corner_radius }}px {{ section.settings.hero_corner_radius }}px 0 0;
    overflow: hidden;
    background: #000;
  }

  .hh-slide {
    position: absolute; inset: 0;
    opacity: 0; transition: opacity 1.2s ease-in-out;
    z-index: 1;
    overflow: visible !important;
    visibility: hidden;
  }

  .hh-slide.active { opacity: 1; z-index: 2; visibility: visible; }

  .hh-bg-media { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
  .hh-bg-media img { 
    width: 100%; height: 100%; object-fit: cover; 
    filter: brightness({{ section.settings.hero_brightness }}) contrast(1.02);
    image-rendering: -webkit-optimize-contrast;
    transform: translateZ(0);
    will-change: opacity, transform;
  }

  /* --- HOTSPOTS --- */
  .hh-hotspot {
    position: absolute; width: 34px; height: 34px;
    transform: translate(-50%, -50%);
    cursor: pointer; z-index: 50;
    pointer-events: auto;
  }

  .hh-hotspot-pulse {
    position: absolute; inset: 0;
    background: #fff; border-radius: 50%;
    box-shadow: 0 0 25px rgba(255,255,255,0.9);
    animation: hh-pulse-anim 3s infinite;
  }

  .hh-hotspot-inner {
    position: absolute; inset: 10px;
    background: var(--hh-accent); border-radius: 50%;
    border: 2px solid #fff; z-index: 2;
    transition: all 0.3s ease;
  }
  .hh-hotspot:hover .hh-hotspot-inner { transform: scale(1.2); background: #fff; border-color: var(--hh-accent); }

  @keyframes hh-pulse-anim {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(3.5); opacity: 0; }
  }

  /* --- POPOVER GLASMÓRFICO AVANZADO --- */
  .hh-product-popover {
    position: absolute;
    width: 260px;
    background: rgba(0,0,0,0.98);
    backdrop-filter: blur(50px);
    -webkit-backdrop-filter: blur(50px);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 30px; padding: 24px;
    opacity: 0; pointer-events: none;
    transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    z-index: 1000;
    box-shadow: 0 50px 120px rgba(0,0,0,0.95), 0 0 40px rgba(48, 98, 223, 0.1);
    bottom: calc(100% + 22px); left: 50%;
    transform: translateX(-50%) translateY(30px) scale(0.8);
  }

  .hh-popover-below { bottom: auto; top: calc(100% + 22px); transform: translateX(-50%) translateY(-30px) scale(0.8); }
  .hh-popover-left { left: 0 !important; transform: translateX(0) translateY(30px) scale(0.8); }
  .hh-popover-right { left: auto !important; right: 0 !important; transform: translateX(0) translateY(30px) scale(0.8); }

  .hh-hotspot:hover .hh-product-popover {
    opacity: 1; pointer-events: auto;
    transform: translateX(var(--tx, -50%)) translateY(0) scale(1);
  }
  
  .hh-popover-left { --tx: 0; }
  .hh-popover-right { --tx: 0; }

  .hh-popover-img {
    width: 100% !important; aspect-ratio: 1;
    object-fit: cover; border-radius: 20px;
    margin-bottom: 20px; display: block;
    image-rendering: -webkit-optimize-contrast;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .hh-popover-title {
    font-size: 15px; font-weight: 800; color: #fff;
    margin: 0 0 8px; line-height: 1.2; text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .hh-popover-price {
    font-size: 20px; font-weight: 900; color: var(--hh-accent);
    margin-bottom: 20px; display: block;
    letter-spacing: -0.03em;
    text-shadow: 0 0 20px rgba(48, 98, 223, 0.4);
  }

  .hh-popover-btn {
    display: flex; align-items: center; justify-content: center;
    width: 100%; padding: 14px;
    background: linear-gradient(135deg, #fff 0%, #d1d1d1 100%);
    color: #000 !important;
    text-align: center; border-radius: 50px;
    font-size: 11px; font-weight: 900;
    text-transform: uppercase; letter-spacing: 0.15em;
    text-decoration: none !important; transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }
  .hh-popover-btn:hover { background: var(--hh-accent); color: #fff !important; transform: translateY(-2px); box-shadow: 0 15px 30px rgba(48, 98, 223, 0.4); }

  /* --- CONTENT --- */
  .hh-content-wrap {
    position: absolute; bottom: 120px; left: 80px;
    z-index: 10; max-width: 950px; pointer-events: none;
  }
  .hh-content-wrap * { pointer-events: auto; }

  .hh-title-main {
    font-family: var(--hh-title-font) !important;
    font-size: {{ section.settings.title_size_desktop }}px;
    color: {{ section.settings.hero_text_color }};
    font-weight: 900; line-height: 0.82;
    letter-spacing: -0.05em; text-transform: uppercase;
    margin: 0 0 25px; font-style: italic;
    text-shadow: 0 15px 60px rgba(0,0,0,0.7);
    display: block;
  }

  .hh-desc-main {
    font-family: var(--hh-desc-font) !important;
    color: {{ section.settings.desc_text_color | default: section.settings.hero_text_color }};
    font-size: {{ section.settings.desc_size_desktop }}px;
    max-width: 650px;
    line-height: 1.45; margin-bottom: 45px;
    text-shadow: 0 2px 20px rgba(0,0,0,0.8);
    opacity: 1;
  }

  .hh-primary-btn {
    background: #fff; color: #000 !important;
    padding: 24px 64px; border-radius: 100px;
    text-decoration: none !important; font-weight: 900;
    text-transform: uppercase; letter-spacing: 0.2em;
    display: inline-block; font-size: 11px;
    box-shadow: 0 25px 60px rgba(0,0,0,0.4);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .hh-slider-nav {
    position: absolute; bottom: 60px; right: 80px;
    display: flex; gap: 15px; z-index: 100;
  }

  .hh-slider-dot {
    width: 50px; height: 6px;
    background: rgba(255,255,255,0.25);
    cursor: pointer; transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    border-radius: 10px;
  }

  .hh-slider-dot.active { background: #fff; width: 90px; box-shadow: 0 0 25px rgba(255,255,255,0.6); }

  @media (max-width: 768px) {
    .hh-title-main { font-size: 54px; }
    .hh-desc-main { font-size: 18px; }
    .hh-content-wrap { left: 25px; bottom: 60px; }
    .hh-product-popover { width: 230px; padding: 18px; }
    .hh-slider-nav { right: 25px; bottom: 40px; }
  }
</style>

<div class="hh-master-{{ section.id }}" id="HHMaster-{{ section.id }}">
  <header class="hh-header-wrapper" id="HHMainHeader-{{ section.id }}">
    <div class="hh-nav-capsule">
      <nav class="hh-nav-links">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="hh-nav-item">{{ link.title }}</a>
        {% endfor %}
      </nav>

      <a href="{{ routes.root_url }}" class="hh-logo-wrap">
        {% if section.settings.logo != blank %}
          {% assign l_w = section.settings.logo_max_width %}
          {% assign l_h = l_w | divided_by: section.settings.logo.aspect_ratio | round %}
          <img src="{{ section.settings.logo | image_url: width: 800 }}" 
               alt="{{ shop.name | escape }}" 
               loading="eager" fetchpriority="high"
               width="{{ l_w }}" height="{{ l_h }}">
        {% else %}
          <div style="color:{{ section.settings.nav_color_idle }}; font-weight:900; font-style:italic; font-size:32px; letter-spacing:-0.05em;">{{ shop.name | upcase }}</div>
        {% endif %}
      </a>

      <div class="hh-actions">
        <a href="{{ routes.cart_url }}" class="hh-cart-trigger">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 10h16v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg>
          <span style="margin-left:6px; font-weight:900;">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </header>

  <div class="hh-hero-viewport">
    {% for block in section.blocks %}
      <div class="hh-slide {% if forloop.first %}active{% endif %}" id="Slide-{{ block.id }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        
        <div class="hh-bg-media">
          {% if block.settings.image != blank %}
            {% liquid
              assign img_width = section.settings.img_definition_width
              assign img_height = img_width | divided_by: block.settings.image.aspect_ratio | round
            %}
            <img src="{{ block.settings.image | image_url: width: img_width }}" 
                 alt="{{ block.settings.title | default: section.settings.title | escape }}" 
                 width="{{ img_width }}" height="{{ img_height }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                 {% if forloop.first %}fetchpriority="high"{% endif %}>
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>

        {% for i in (1..4) %}
          {% capture product_key %}product_{{ i }}{% endcapture %}
          {% capture pos_x_key %}pos_x_{{ i }}{% endcapture %}
          {% capture pos_y_key %}pos_y_{{ i }}{% endcapture %}
          
          {% assign spot_product = block.settings[product_key] %}
          {% if spot_product != blank %}
            {% liquid
              assign y_pos = block.settings[pos_y_key]
              assign x_pos = block.settings[pos_x_key]
              assign v_class = "hh-popover-above"
              if y_pos < 45
                assign v_class = "hh-popover-below"
              endif
              assign h_class = ""
              if x_pos < 15
                assign h_class = "hh-popover-left"
              elsif x_pos > 85
                assign h_class = "hh-popover-right"
              endif
            %}
            <div class="hh-hotspot" style="left: {{ x_pos }}%; top: {{ y_pos }}%;">
              <div class="hh-hotspot-pulse"></div>
              <div class="hh-hotspot-inner"></div>
              <div class="hh-product-popover {{ v_class }} {{ h_class }}">
                {% if spot_product.featured_image != blank %}
                  {% assign p_w = 400 %}
                  {% assign p_h = p_w | divided_by: spot_product.featured_image.aspect_ratio | round %}
                  <img src="{{ spot_product.featured_image | image_url: width: p_w }}" 
                       class="hh-popover-img" 
                       alt="{{ spot_product.title | escape }}"
                       width="{{ p_w }}" height="{{ p_h }}" loading="lazy">
                {% endif %}
                <h4 class="hh-popover-title">{{ spot_product.title }}</h4>
                <span class="hh-popover-price">{{ spot_product.price | money }}</span>
                <a href="{{ spot_product.url }}" class="hh-popover-btn">Comprar Ahora</a>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        <div class="hh-content-wrap">
          <h2 class="hh-title-main">{{ block.settings.title | default: section.settings.title }}</h2>
          <p class="hh-desc-main">{{ block.settings.subtitle | default: section.settings.subtitle }}</p>
          {% if block.settings.btn_text != blank %}
            <a href="{{ block.settings.btn_link }}" class="hh-primary-btn">{{ block.settings.btn_text }}</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}

    {% if section.blocks.size > 1 %}
      <div class="hh-slider-nav">
        {% for block in section.blocks %}
          <div class="hh-slider-dot {% if forloop.first %}active{% endif %}" data-target="{{ forloop.index0 }}"></div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    const container = document.getElementById('HHMaster-{{ section.id }}');
    if (!container) return;
    const header = document.getElementById('HHMainHeader-{{ section.id }}');
    const viewport = container.querySelector('.hh-hero-viewport');
    const slides = container.querySelectorAll('.hh-slide');
    const dots = container.querySelectorAll('.hh-slider-dot');
    const storageKey = 'hh_last_slide_{{ section.id }}';
    
    let current = 0;
    let autoplayInterval = null;
    let isEditing = false;
    let isHovering = false;

    // Cargar última diapositiva guardada
    const savedSlide = sessionStorage.getItem(storageKey);
    if (savedSlide !== null && slides[savedSlide]) {
      current = parseInt(savedSlide);
    }

    const goToSlide = (index) => {
      if (index < 0 || index >= slides.length) return;
      slides.forEach(s => s.classList.remove('active'));
      dots.forEach(d => d.classList.remove('active'));
      if(slides[index]) slides[index].classList.add('active');
      if(dots[index]) dots[index].classList.add('active');
      current = index;
      sessionStorage.setItem(storageKey, index); // Persistir estado
    };

    const startAutoplay = () => {
      if (isEditing || isHovering) return;
      {% if section.settings.autoplay %}
      if (autoplayInterval) clearInterval(autoplayInterval);
      autoplayInterval = setInterval(() => {
        let next = (current + 1) % slides.length;
        goToSlide(next);
      }, {{ section.settings.autoplay_speed }} * 1000);
      {% endif %}
    };

    const stopAutoplay = () => {
      if (autoplayInterval) { clearInterval(autoplayInterval); autoplayInterval = null; }
    };

    // Inicialización del slide
    goToSlide(current);

    dots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(parseInt(dot.dataset.target));
        stopAutoplay();
        if (!isEditing && !isHovering) startAutoplay(); 
      });
    });

    // Pausar al pasar el ratón por el viewport (Hotspots y Contenido)
    viewport.addEventListener('mouseenter', () => {
      isHovering = true;
      stopAutoplay();
    });

    viewport.addEventListener('mouseleave', () => {
      isHovering = false;
      if (!isEditing) startAutoplay();
    });

    window.addEventListener('scroll', () => {
      if (window.scrollY > 60) header.classList.add('is-scrolled');
      else header.classList.remove('is-scrolled');
    }, { passive: true });

    startAutoplay();

    /* Shopify Design Mode Integration */
    if (Shopify.designMode) {
      document.addEventListener('shopify:block:select', (event) => {
        if (event.detail.sectionId !== '{{ section.id }}') return;
        isEditing = true; stopAutoplay();
        const blockId = event.detail.blockId;
        const selectedSlide = container.querySelector('#Slide-' + blockId);
        if (selectedSlide) {
          const index = parseInt(selectedSlide.dataset.index);
          goToSlide(index);
        }
      });
      document.addEventListener('shopify:block:deselect', (event) => {
        if (event.detail.sectionId !== '{{ section.id }}') return;
        isEditing = false; startAutoplay();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Divine Hero Master V6.2",
  "settings": [
    { "type": "header", "content": "1. IDENTIDAD (LOGO)" },
    { "type": "image_picker", "id": "logo", "label": "Logo Principal" },
    { "type": "range", "id": "logo_max_width", "min": 50, "max": 400, "step": 5, "unit": "px", "label": "Ancho Máximo Logo", "default": 180 },
    { "type": "color", "id": "accent_color", "label": "Color de Acento", "default": "#3062DF" },
    { "type": "header", "content": "2. HEADER (CRISTAL)" },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "font_picker", "id": "nav_font_family", "label": "Fuente Menú", "default": "sans-serif" },
    { "type": "range", "id": "nav_font_size", "min": 8, "max": 20, "step": 1, "unit": "px", "label": "Tamaño Fuente", "default": 10 },
    { "type": "select", "id": "nav_font_weight", "label": "Grosor Fuente", "options": [
        { "value": "400", "label": "Normal" },
        { "value": "700", "label": "Bold" },
        { "value": "900", "label": "Black" }
      ], "default": "900" },
    { "type": "color", "id": "nav_color_idle", "label": "Color (Normal)", "default": "#FFFFFF" },
    { "type": "color", "id": "nav_color_scroll", "label": "Color (Scroll)", "default": "#000000" },
    { "type": "color", "id": "header_bg_scroll", "label": "Fondo Cristal", "default": "#FFFFFF" },
    { "type": "range", "id": "header_opacity_scroll", "min": 0, "max": 1, "step": 0.1, "label": "Opacidad Cristal", "default": 0.5 },
    { "type": "range", "id": "header_blur", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Desenfoque Cristal", "default": 40 },
    { "type": "header", "content": "3. TIPOGRAFÍA Y TEXTOS" },
    { "type": "font_picker", "id": "title_font_family", "label": "Fuente del Título Principal", "default": "sans-serif" },
    { "type": "range", "id": "title_size_desktop", "min": 40, "max": 240, "step": 5, "unit": "px", "label": "Tamaño Título (Desktop)", "default": 140 },
    { "type": "color", "id": "hero_text_color", "label": "Color Título Hero", "default": "#FFFFFF" },
    { "type": "header", "content": "Descripción Hero" },
    { "type": "font_picker", "id": "desc_font_family", "label": "Fuente Descripción", "default": "sans-serif" },
    { "type": "range", "id": "desc_size_desktop", "min": 10, "max": 60, "step": 1, "unit": "px", "label": "Tamaño Descripción (Desktop)", "default": 22 },
    { "type": "color", "id": "desc_text_color", "label": "Color Descripción", "default": "#FFFFFF" },
    { "type": "font_picker", "id": "font_family", "label": "Fuente Secundaria Global", "default": "sans-serif" },
    { "type": "header", "content": "4. CALIDAD VISUAL HD" },
    { "type": "range", "id": "img_definition_width", "min": 1200, "max": 5000, "step": 200, "unit": "px", "label": "Definición de Imagen (PX)", "default": 4000 },
    { "type": "range", "id": "hero_brightness", "min": 0.3, "max": 1.5, "step": 0.1, "label": "Brillo de Imagen", "default": 1.0 },
    { "type": "range", "id": "hero_corner_radius", "min": 0, "max": 120, "step": 5, "unit": "px", "label": "Curvatura Hero", "default": 40 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotación", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 2, "max": 15, "step": 1, "unit": "s", "label": "Velocidad Cambio", "default": 7 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Imagen Hero HD + Hotspots",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen Hero" },
        { "type": "text", "id": "title", "label": "Título Diapositiva", "default": "Pure Essence" },
        { "type": "textarea", "id": "subtitle", "label": "Descripción", "default": "Tecnología de absorción celular profunda." },
        { "type": "text", "id": "btn_text", "label": "Texto Botón", "default": "Ver Colección" },
        { "type": "url", "id": "btn_link", "label": "Link Botón" },
