{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "functions": {
    "api/send-email.ts": {
      "maxDuration": 60
    },
    "api/create-payment.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    { "source": "/checkout", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/pago-(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/checkout", "destination": "/" },
    { "source": "/pago-exitoso", "destination": "/" },
    { "source": "/pago-error", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ]
}
