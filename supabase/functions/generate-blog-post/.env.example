# ── Divina Store — Edge Function: generate-blog-post ──────────────
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# Clave de API de Anthropic (Claude)
# Obtén la tuya en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# URL pública de tu proyecto Supabase
# Formato: https://<tu-proyecto>.supabase.co
SUPABASE_URL=https://[tu-proyecto].supabase.co

# Service Role Key (con permisos de escritura en blog_posts)
# Encuéntrala en: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...
